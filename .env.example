 # Copy to .env.local for development. Never commit real credentials.

   # LLM provider: "fake" (deterministic, no network) or "openai" (opt-in, requires OPENAI_API_KEY)
   AI_PROVIDER=fake

   # Retrieval strategy: "lexical" (baseline) or "hybrid" (adds pgvector similarity)
   AI_RETRIEVAL=lexical

   # Local PostgreSQL + pgvector (docker compose). Default host port is 5432;
   # if another PostgreSQL already occupies it, start with POSTGRES_HOST_PORT=55434
   # and point DATABASE_URL at that port.
   DATABASE_URL=postgresql://assistant:assistant@127.0.0.1:5432/assistant_dev

   # Never log raw user messages or full prompts by default.
   LOG_RAW_CONTENT=false

   # Hosted provider settings (only used when AI_PROVIDER=openai).
   OPENAI_API_KEY=
   OPENAI_CHAT_MODEL=
   OPENAI_EMBEDDING_MODEL=
   MODEL_PRICING_VERSION=